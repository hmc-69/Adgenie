DATABASE_URL=mysql+pymysql://root:@localhost:3306/adgenie
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the generated value private in backend/.env; never commit it.
JWT_SECRET_KEY=replace-with-a-generated-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AI_PROVIDER=gemini
AI_FALLBACK_TO_MOCK=true
AUDIENCE_CLASSIFIER_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
JSON2VIDEO_API_KEY=
PEXELS_API_KEY=
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_IMAGE_API_URL=https://adgenie-image.hemanthchandran541.workers.dev/
CLOUDFLARE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=adgenie-images
